@model ReportStatisticsDto
@{
    ViewData["Title"] = "Report Statistics";
    string? startDate = ViewBag.StartDate;
    string? endDate = ViewBag.EndDate;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold tracking-tight text-dark mb-1">
            <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Report Statistics
        </h2>
        <p class="text-muted small mb-0">Statistical analytics and report generation based on news created date period</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportToWord" asp-route-startDate="@startDate" asp-route-endDate="@endDate" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm d-print-none">
            <i class="bi bi-file-earmark-word-fill me-1"></i> Export to Word (.docx)
        </a>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-print-none">
            <i class="bi bi-printer me-1"></i> Print
        </button>
    </div>
</div>

<!-- Date Filter Form -->
<div class="card border-0 shadow-sm mb-4 d-print-none">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-sm-6 col-md-4">
                <label class="form-label fw-semibold text-secondary small">Start Date (From)</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-calendar-event"></i></span>
                    <input type="date" name="startDate" value="@startDate" class="form-control" />
                </div>
            </div>
            <div class="col-sm-6 col-md-4">
                <label class="form-label fw-semibold text-secondary small">End Date (To)</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-calendar-event"></i></span>
                    <input type="date" name="endDate" value="@endDate" class="form-control" />
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4 flex-grow-1 shadow-sm">
                    <i class="bi bi-funnel-fill me-1"></i> Generate Report
                </button>
                @if (!string.IsNullOrEmpty(startDate) || !string.IsNullOrEmpty(endDate))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card shadow-sm border-0">
            <div class="stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-newspaper"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Total Articles</div>
                <h3 class="fw-bold mb-0 text-dark">@Model.TotalArticles</h3>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card shadow-sm border-0">
            <div class="stat-icon bg-success-subtle text-success">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Active (Published)</div>
                <h3 class="fw-bold mb-0 text-success">@Model.ActiveArticles</h3>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card shadow-sm border-0">
            <div class="stat-icon bg-secondary-subtle text-secondary">
                <i class="bi bi-dash-circle-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Inactive (Drafts)</div>
                <h3 class="fw-bold mb-0 text-secondary">@Model.InactiveArticles</h3>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card shadow-sm border-0">
            <div class="stat-icon bg-info-subtle text-info">
                <i class="bi bi-tags-fill"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold">Categories Represented</div>
                <h3 class="fw-bold mb-0 text-dark">@(Model.ArticlesByCategory?.Count ?? 0)</h3>
            </div>
        </div>
    </div>
</div>

<!-- Category Distribution Overview -->
@if (Model.ArticlesByCategory != null && Model.ArticlesByCategory.Any())
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="fw-bold text-dark small mb-2"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Breakdown by Category:</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var kvp in Model.ArticlesByCategory)
                {
                    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill small">
                        <strong>@kvp.Key</strong>: <span class="badge bg-primary text-white ms-1">@kvp.Value</span>
                    </span>
                }
            </div>
        </div>
    </div>
}

<!-- Detailed Report Table (Sorted in descending order by created date) -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-table text-primary me-2"></i>Articles Report (Sorted by Created Date Descending)
        </h5>
        <span class="badge bg-dark-subtle text-dark border rounded-pill px-3 py-1">
            @Model.Articles.Count records
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">#</th>
                    <th>Article ID</th>
                    <th>Created Date</th>
                    <th>Headline</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Status</th>
                    <th class="pe-4">Tags</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Articles == null || !Model.Articles.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-file-earmark-x fs-1 d-block mb-2 text-secondary"></i>
                            No news articles created within the selected period.
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    @foreach (var art in Model.Articles)
                    {
                        <tr>
                            <td class="ps-4 text-muted small">@(index++)</td>
                            <td class="fw-semibold text-secondary small">#@art.NewsArticleID</td>
                            <td class="small fw-semibold text-dark">
                                <i class="bi bi-clock me-1 text-primary"></i>@(art.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                            </td>
                            <td style="max-width: 300px;">
                                <div class="fw-bold text-dark text-truncate">@art.Headline</div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                                    @(art.CategoryName ?? "General")
                                </span>
                            </td>
                            <td class="small text-muted">
                                <i class="bi bi-person me-1"></i>@(art.CreatedByName ?? "Staff")
                            </td>
                            <td>
                                @if (art.NewsStatus == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-1 small">
                                        Inactive
                                    </span>
                                }
                            </td>
                            <td class="pe-4 small" style="max-width: 180px;">
                                <div class="d-flex flex-wrap gap-1">
                                    @if (art.TagNames != null && art.TagNames.Any())
                                    {
                                        @foreach (var t in art.TagNames.Take(2))
                                        {
                                            <span class="badge bg-light text-secondary border small">#@t</span>
                                        }
                                        @if (art.TagNames.Count > 2)
                                        {
                                            <span class="badge bg-light text-secondary border small">+@(art.TagNames.Count - 2)</span>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
