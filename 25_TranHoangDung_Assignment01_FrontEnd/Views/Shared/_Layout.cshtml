@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var sessionUser = UserSession.FromHttpContext(HttpContextAccessor.HttpContext!);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUNews Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm py-2" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;">
            <div class="container-fluid px-3 px-xl-5">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-nowrap" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 shadow-sm px-2 py-1">
                        <i class="bi bi-newspaper fs-5"></i>
                    </span>
                    <span class="fs-5 tracking-tight text-white">FUNews <span class="badge bg-primary text-white border border-primary-subtle fs-7 ms-1">Management System</span></span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 rounded-2 text-white-50 hover-light text-nowrap d-inline-flex align-items-center" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-globe me-2"></i>Public News
                            </a>
                        </li>

                        @if (sessionUser.IsLoggedIn && sessionUser.IsAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-2 text-white-50 hover-light text-nowrap d-inline-flex align-items-center" asp-controller="Accounts" asp-action="Index">
                                    <i class="bi bi-people-fill me-2"></i>Manage Accounts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-2 text-white-50 hover-light text-nowrap d-inline-flex align-items-center" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-line-fill me-2"></i>Report Statistics
                                </a>
                            </li>
                        }

                        @if (sessionUser.IsLoggedIn && sessionUser.IsStaff)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-2 text-white-50 hover-light text-nowrap d-inline-flex align-items-center" asp-controller="NewsArticles" asp-action="Index">
                                    <i class="bi bi-file-earmark-text-fill me-2"></i>Manage News
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-2 text-white-50 hover-light text-nowrap d-inline-flex align-items-center" asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-folder-fill me-2"></i>Manage Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-2 text-white-50 hover-light text-nowrap d-inline-flex align-items-center" asp-controller="NewsArticles" asp-action="History">
                                    <i class="bi bi-clock-history me-2"></i>My History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 rounded-2 text-white-50 hover-light text-nowrap d-inline-flex align-items-center" asp-controller="Profile" asp-action="Index">
                                    <i class="bi bi-person-circle me-2"></i>My Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 flex-shrink-0 mt-2 mt-lg-0">
                        @if (sessionUser.IsLoggedIn)
                        {
                            <div class="dropdown">
                                <button class="btn btn-outline-light btn-sm rounded-pill d-flex align-items-center gap-2 py-1 px-3 dropdown-toggle text-nowrap" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="avatar-circle bg-primary text-white d-flex align-items-center justify-content-center rounded-circle fw-bold" style="width: 26px; height: 26px; font-size: 0.75rem;">
                                        @sessionUser.AccountName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-semibold small">@sessionUser.AccountName</span>
                                    @if (sessionUser.IsAdmin)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Admin</span>
                                    }
                                    else if (sessionUser.IsStaff)
                                    {
                                        <span class="badge bg-success text-white rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Staff</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-white rounded-pill px-2 py-0.5" style="font-size: 0.7rem;">Lecturer</span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 rounded-3" style="min-width: 220px;">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-bold small text-dark">@sessionUser.AccountName</div>
                                        <div class="text-muted text-truncate" style="font-size: 0.75rem;">@sessionUser.AccountEmail</div>
                                    </li>
                                    @if (sessionUser.IsStaff)
                                    {
                                        <li>
                                            <a class="dropdown-item small py-2" asp-controller="Profile" asp-action="Index">
                                                <i class="bi bi-person-circle me-2 text-primary"></i>My Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item small py-2" asp-controller="NewsArticles" asp-action="History">
                                                <i class="bi bi-clock-history me-2 text-info"></i>My History
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-1"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item small text-danger py-2" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </a>
                                    </li>
                                </ul>
                            </div>
                            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 text-nowrap shadow-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>Logout
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm text-nowrap">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill fs-5 text-success"></i>
                <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
                <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="mt-auto py-3 bg-white border-top text-center text-muted small">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <span>&copy; @DateTime.Now.Year FUNews Management System - <strong>PRN232 Assignment 01 (25_TranHoangDung)</strong></span>
            <span class="text-secondary"><i class="bi bi-shield-check text-success me-1"></i> 3-Layer Architecture &bull; OData &bull; EF Core</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
