@model List<SystemAccount>
@{
    ViewData["Title"] = "Account Management";
    string? currentSearch = ViewBag.CurrentSearch;
    int? currentRole = ViewBag.CurrentRole;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold tracking-tight text-dark mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Account Management
        </h2>
        <p class="text-muted small mb-0">Administer system accounts for university staff and lecturers</p>
    </div>
    <button type="button" class="btn btn-primary px-3 py-2 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createAccountModal">
        <i class="bi bi-person-plus-fill me-1"></i> Create Account
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6 col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" placeholder="Search by name or email..." />
                </div>
            </div>
            <div class="col-md-4 col-lg-3">
                <select name="role" class="form-select">
                    <option value="">All Roles</option>
                    <!option value="1" @(currentRole == 1 ? "selected" : "")>Staff (Role = 1)</!option>
                    <!option value="2" @(currentRole == 2 ? "selected" : "")>Lecturer (Role = 2)</!option>
                </select>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-dark px-3">Filter</button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentRole.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Accounts Table Card -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Account Name</th>
                    <th>Email Address</th>
                    <th>Role</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                            No accounts match your criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var acc in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-secondary">#@acc.AccountID</td>
                            <td class="fw-bold text-dark">@acc.AccountName</td>
                            <td class="text-muted"><i class="bi bi-envelope me-1"></i>@acc.AccountEmail</td>
                            <td>
                                @if (acc.AccountRole == 1)
                                {
                                    <span class="badge badge-staff rounded-pill px-3 py-1">
                                        <i class="bi bi-person-badge-fill me-1"></i>Staff
                                    </span>
                                }
                                else if (acc.AccountRole == 2)
                                {
                                    <span class="badge badge-lecturer rounded-pill px-3 py-1">
                                        <i class="bi bi-mortarboard-fill me-1"></i>Lecturer
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary text-white rounded-pill px-3 py-1">Other</span>
                                }
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1 btn-edit-account"
                                        data-bs-toggle="modal" data-bs-target="#editAccountModal"
                                        data-id="@acc.AccountID">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 btn-delete-account"
                                        data-bs-toggle="modal" data-bs-target="#deleteAccountModal"
                                        data-id="@acc.AccountID" data-name="@acc.AccountName">
                                    <i class="bi bi-trash3 me-1"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ================= CREATE ACCOUNT MODAL ================= -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="createAccountModalLabel">
                        <i class="bi bi-person-plus-fill me-2"></i>Create New Account
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Account Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="AccountName" class="form-control" placeholder="e.g. John Doe" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="AccountEmail" class="form-control" placeholder="name@FUNewsManagement.org" required maxlength="70" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Account Role <span class="text-danger">*</span></label>
                        <select name="AccountRole" class="form-select" required>
                            <option value="1">Staff (Role = 1)</option>
                            <option value="2">Lecturer (Role = 2)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Password <span class="text-danger">*</span></label>
                        <input type="password" name="AccountPassword" class="form-control" placeholder="••••••••" required maxlength="70" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= EDIT ACCOUNT MODAL ================= -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-labelledby="editAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="editAccountForm" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AccountID" id="editAccountId" />
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="editAccountModalLabel">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Update Account
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Account Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="AccountName" id="editAccountName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="AccountEmail" id="editAccountEmail" class="form-control" required maxlength="70" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Account Role <span class="text-danger">*</span></label>
                        <select name="AccountRole" id="editAccountRole" class="form-select" required>
                            <option value="1">Staff (Role = 1)</option>
                            <option value="2">Lecturer (Role = 2)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">New Password <span class="text-muted small">(Leave blank to keep unchanged)</span></label>
                        <input type="password" name="AccountPassword" id="editAccountPassword" class="form-control" placeholder="••••••••" maxlength="70" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= DELETE CONFIRMATION MODAL ================= -->
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="deleteAccountForm" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteAccountId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="deleteAccountModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Account Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="deleteWarningAlert" class="alert alert-danger d-none d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-shield-x fs-4"></i>
                        <div id="deleteWarningMessage"></div>
                    </div>
                    <p class="mb-0" id="deleteConfirmText">
                        Are you sure you want to delete account: <strong id="deleteAccountName"></strong>?
                    </p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnConfirmDelete" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash3 me-1"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Edit Account Modal loader
            $(document).on('click', '.btn-edit-account', function () {
                var accountId = $(this).data('id');
                $('#editAccountId').val(accountId);
                $('#editAccountForm').attr('action', '/Accounts/Edit/' + accountId);

                $.getJSON('/Accounts/GetAccountJson/' + accountId, function (data) {
                    if (data) {
                        $('#editAccountId').val(data.accountID);
                        $('#editAccountName').val(data.accountName);
                        $('#editAccountEmail').val(data.accountEmail);
                        $('#editAccountRole').val(data.accountRole);
                        $('#editAccountPassword').val('');
                    }
                });
            });

            // Delete Account Modal loader & check constraint
            $(document).on('click', '.btn-delete-account', function () {
                var accountId = $(this).data('id');
                var accountName = $(this).data('name');

                $('#deleteAccountId').val(accountId);
                $('#deleteAccountName').text(accountName + ' (#' + accountId + ')');
                $('#deleteAccountForm').attr('action', '/Accounts/Delete/' + accountId);

                // Initial state
                $('#deleteWarningAlert').addClass('d-none');
                $('#btnConfirmDelete').prop('disabled', true).text('Checking...');

                $.getJSON('/Accounts/CheckDelete/' + accountId, function (res) {
                    if (res && res.canDelete === false) {
                        $('#deleteWarningAlert').removeClass('d-none');
                        $('#deleteWarningMessage').text(res.message || 'Cannot delete this account because it has already created news articles.');
                        $('#btnConfirmDelete').prop('disabled', true).html('<i class="bi bi-slash-circle me-1"></i> Cannot Delete');
                    } else {
                        $('#deleteWarningAlert').addClass('d-none');
                        $('#btnConfirmDelete').prop('disabled', false).html('<i class="bi bi-trash3 me-1"></i> Confirm Delete');
                    }
                }).fail(function () {
                    // Fallback in case of network issue
                    $('#btnConfirmDelete').prop('disabled', false).html('<i class="bi bi-trash3 me-1"></i> Confirm Delete');
                });
            });
        });
    </script>
}
