@model UserProfileDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-7 col-md-9">
        <div class="card border-0 shadow-sm overflow-hidden rounded-4 bg-white">
            <div class="p-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-circle bg-primary text-white d-flex align-items-center justify-content-center rounded-circle fs-3 fw-bold" style="width: 64px; height: 64px;">
                        @((Model.AccountName ?? "U")[0].ToString().ToUpper())
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1">@Model.AccountName</h4>
                        <div class="text-white-50 small mb-1"><i class="bi bi-envelope me-1"></i>@Model.AccountEmail</div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small">
                            <i class="bi bi-person-badge-fill me-1"></i>Staff Member (ID: #@Model.AccountID)
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-gear-fill text-primary me-2"></i>Edit Profile Information</h5>
                <p class="text-muted small mb-4">Update your display name and credentials for the FUNews Management System.</p>

                <form method="post" asp-action="Update">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
                    <input type="hidden" asp-for="AccountID" />
                    <input type="hidden" asp-for="AccountRole" />
                    <input type="hidden" asp-for="AccountEmail" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Email Address</label>
                        <input type="text" class="form-control bg-light" value="@Model.AccountEmail" readonly />
                        <div class="form-text small">Email address cannot be modified as it serves as your login identifier.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label fw-semibold text-secondary small">Full Name <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="AccountName" class="form-control" required maxlength="100" />
                        </div>
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AccountPassword" class="form-label fw-semibold text-secondary small">New Password <span class="text-muted small">(Leave blank if you don't want to change)</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                            <input asp-for="AccountPassword" type="password" class="form-control" placeholder="••••••••" maxlength="70" />
                        </div>
                        <span asp-validation-for="AccountPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-controller="NewsArticles" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
