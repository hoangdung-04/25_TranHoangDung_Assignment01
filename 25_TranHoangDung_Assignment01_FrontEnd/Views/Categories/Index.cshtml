@model List<Category>
@{
    ViewData["Title"] = "Category Management";
    string? currentSearch = ViewBag.CurrentSearch;
    bool? currentActiveOnly = ViewBag.CurrentActiveOnly;
    var allCategories = ViewBag.AllCategories as List<Category> ?? new List<Category>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold tracking-tight text-dark mb-1">
            <i class="bi bi-folder-fill text-primary me-2"></i>Category Management
        </h2>
        <p class="text-muted small mb-0">Organize and manage university news publishing categories</p>
    </div>
    <button type="button" class="btn btn-primary px-3 py-2 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-folder-plus me-1"></i> Create Category
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-7 col-lg-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" placeholder="Search by category name or description..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="activeOnly" class="form-select">
                    <option value="">All Statuses</option>
                    <!option value="true" @(currentActiveOnly == true ? "selected" : "")>Active Only</!option>
                    <!option value="false" @(currentActiveOnly == false ? "selected" : "")>Inactive Only</!option>
                </select>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-dark px-3">Filter</button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentActiveOnly.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Categories Table Card -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Category Name</th>
                    <th>Description</th>
                    <th>Parent Category</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                            No categories found matching your query.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-secondary">#@cat.CategoryID</td>
                            <td class="fw-bold text-dark">
                                <i class="bi bi-folder2-open text-primary me-2"></i>@cat.CategoryName
                            </td>
                            <td class="text-muted small" style="max-width: 320px;">@cat.CategoryDesciption</td>
                            <td class="text-secondary small">
                                @(cat.ParentCategory != null ? cat.ParentCategory.CategoryName : "None (Root)")
                            </td>
                            <td>
                                @if (cat.IsActive == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">
                                        <i class="bi bi-slash-circle me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1 btn-edit-category"
                                        data-bs-toggle="modal" data-bs-target="#editCategoryModal"
                                        data-id="@cat.CategoryID">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 btn-delete-category"
                                        data-bs-toggle="modal" data-bs-target="#deleteCategoryModal"
                                        data-id="@cat.CategoryID" data-name="@cat.CategoryName">
                                    <i class="bi bi-trash3 me-1"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ================= CREATE CATEGORY MODAL ================= -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="createCategoryModalLabel">
                        <i class="bi bi-folder-plus me-2"></i>Create New Category
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="CategoryName" class="form-control" placeholder="e.g. Science & Technology" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Description <span class="text-danger">*</span></label>
                        <textarea name="CategoryDesciption" class="form-control" rows="3" placeholder="Category purpose and scope..." required maxlength="250"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Parent Category</label>
                        <select name="ParentCategoryID" class="form-select">
                            <option value="">-- None (Top Level Category) --</option>
                            @foreach (var c in allCategories)
                            {
                                <option value="@c.CategoryID">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="createIsActive" checked>
                        <label class="form-check-label fw-semibold text-dark small" for="createIsActive">Active (Publishable)</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Category</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= EDIT CATEGORY MODAL ================= -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="editCategoryForm" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CategoryID" id="editCategoryId" />
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="editCategoryModalLabel">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Update Category
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Category Name <span class="text-danger">*</span></label>
                        <input type="text" name="CategoryName" id="editCategoryName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Description <span class="text-danger">*</span></label>
                        <textarea name="CategoryDesciption" id="editCategoryDescription" class="form-control" rows="3" required maxlength="250"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Parent Category</label>
                        <select name="ParentCategoryID" id="editParentCategoryId" class="form-select">
                            <option value="">-- None (Top Level Category) --</option>
                            @foreach (var c in allCategories)
                            {
                                <option value="@c.CategoryID">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editIsActive">
                        <label class="form-check-label fw-semibold text-dark small" for="editIsActive">Active (Publishable)</label>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= DELETE CONFIRMATION MODAL ================= -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="deleteCategoryForm" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteCategoryId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="deleteCategoryModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Category Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="deleteCatWarningAlert" class="alert alert-danger d-none d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-shield-x fs-4"></i>
                        <div id="deleteCatWarningMessage"></div>
                    </div>
                    <p class="mb-0" id="deleteCatConfirmText">
                        Are you sure you want to delete category: <strong id="deleteCategoryName"></strong>?
                    </p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnConfirmDeleteCat" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash3 me-1"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Edit Category Modal loader
            $(document).on('click', '.btn-edit-category', function () {
                var categoryId = $(this).data('id');
                $('#editCategoryId').val(categoryId);
                $('#editCategoryForm').attr('action', '/Categories/Edit/' + categoryId);

                $.getJSON('/Categories/GetCategoryJson/' + categoryId, function (data) {
                    if (data) {
                        $('#editCategoryId').val(data.categoryID);
                        $('#editCategoryName').val(data.categoryName);
                        $('#editCategoryDescription').val(data.categoryDesciption);
                        $('#editParentCategoryId').val(data.parentCategoryID || '');
                        $('#editIsActive').prop('checked', data.isActive === true);
                    }
                });
            });

            // Delete Category Modal loader & check constraint
            $(document).on('click', '.btn-delete-category', function () {
                var categoryId = $(this).data('id');
                var categoryName = $(this).data('name');

                $('#deleteCategoryId').val(categoryId);
                $('#deleteCategoryName').text(categoryName + ' (#' + categoryId + ')');
                $('#deleteCategoryForm').attr('action', '/Categories/Delete/' + categoryId);

                // Initial state
                $('#deleteCatWarningAlert').addClass('d-none');
                $('#btnConfirmDeleteCat').prop('disabled', true).text('Checking...');

                $.getJSON('/Categories/CheckDelete/' + categoryId, function (res) {
                    if (res && res.canDelete === false) {
                        $('#deleteCatWarningAlert').removeClass('d-none');
                        $('#deleteCatWarningMessage').text(res.message || 'Cannot delete category because it has associated news articles.');
                        $('#btnConfirmDeleteCat').prop('disabled', true).html('<i class="bi bi-slash-circle me-1"></i> Cannot Delete');
                    } else {
                        $('#deleteCatWarningAlert').addClass('d-none');
                        $('#btnConfirmDeleteCat').prop('disabled', false).html('<i class="bi bi-trash3 me-1"></i> Confirm Delete');
                    }
                }).fail(function () {
                    $('#btnConfirmDeleteCat').prop('disabled', false).html('<i class="bi bi-trash3 me-1"></i> Confirm Delete');
                });
            });
        });
    </script>
}
