@model List<NewsArticleDto>
@{
    ViewData["Title"] = "FUNews Management System - News Portal";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    short? currentCategory = ViewBag.CurrentCategory;
    string? currentSearch = ViewBag.CurrentSearch;
}

<div class="p-4 p-md-5 mb-4 rounded-4 text-white shadow-sm" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #06b6d4 100%);">
    <div class="col-lg-8 px-0">
        <span class="badge bg-white text-primary px-3 py-1 mb-2 rounded-pill fw-semibold">FUNews Management System</span>
        <h1 class="display-5 fw-bold tracking-tight mb-2">Campus News & Announcements</h1>
        <p class="lead mb-4 text-light opacity-90">Stay informed with the latest academic discoveries, student life events, and university milestones.</p>
        
        <form method="get" asp-controller="Home" asp-action="Index" class="d-flex flex-column flex-sm-row gap-2 bg-white p-2 rounded-3 shadow">
            <input type="hidden" name="categoryId" value="@currentCategory" />
            <div class="input-group">
                <span class="input-group-text bg-transparent border-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@currentSearch" class="form-control border-0 shadow-none ps-0" placeholder="Search by title, headline, or keywords..." />
            </div>
            <button type="submit" class="btn btn-primary px-4 py-2 rounded-2">Search</button>
            @if (!string.IsNullOrEmpty(currentSearch) || currentCategory.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-2">Clear</a>
            }
        </form>
    </div>
</div>

<!-- Category Filter Pills -->
<div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
    <span class="text-muted small fw-semibold me-1"><i class="bi bi-funnel me-1"></i>Filter Category:</span>
    <a asp-action="Index" asp-route-search="@currentSearch" 
       class="btn btn-sm rounded-pill @(currentCategory == null ? "btn-dark text-white" : "btn-outline-secondary")">
        All Categories
    </a>
    @foreach (var cat in categories)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.CategoryID" asp-route-search="@currentSearch"
           class="btn btn-sm rounded-pill @(currentCategory == cat.CategoryID ? "btn-primary text-white" : "btn-outline-secondary")">
            @cat.CategoryName
        </a>
    }
</div>

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold">No active news articles found</h5>
            <p class="text-muted">Try adjusting your search criteria or selecting a different category.</p>
            <a asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill mt-2">View All News</a>
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var article in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm card-hover overflow-hidden">
                    <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                            <i class="bi bi-tag-fill me-1"></i>@(article.CategoryName ?? "General")
                        </span>
                        <small class="text-muted">
                            <i class="bi bi-calendar3 me-1"></i>@(article.CreatedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                        </small>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-dark mt-2 mb-2 line-clamp-2">
                            <a asp-action="Details" asp-route-id="@article.NewsArticleID" class="text-decoration-none text-dark hover-primary">
                                @(string.IsNullOrEmpty(article.NewsTitle) ? article.Headline : article.NewsTitle)
                            </a>
                        </h5>
                        <p class="card-text text-secondary small flex-grow-1 line-clamp-3">
                            @article.Headline
                        </p>
                        
                        @if (article.TagNames != null && article.TagNames.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mt-2 mb-3">
                                @foreach (var tag in article.TagNames.Take(3))
                                {
                                    <span class="badge bg-light text-secondary border small">#@tag</span>
                                }
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center pt-3 mt-auto border-top">
                            <div class="small text-muted d-flex align-items-center gap-1">
                                <i class="bi bi-person-circle"></i>
                                <span>@(article.CreatedByName ?? "Editor")</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@article.NewsArticleID" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                Read More <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
