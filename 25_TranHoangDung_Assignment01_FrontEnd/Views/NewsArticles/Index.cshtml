@model List<NewsArticleDto>
@{
    ViewData["Title"] = "News Article Management";
    string? currentSearch = ViewBag.CurrentSearch;
    short? currentCategory = ViewBag.CurrentCategory;
    bool? currentStatus = ViewBag.CurrentStatus;
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var tags = ViewBag.Tags as List<Tag> ?? new List<Tag>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold tracking-tight text-dark mb-1">
            <i class="bi bi-file-earmark-text-fill text-primary me-2"></i>News Article Management
        </h2>
        <p class="text-muted small mb-0">Publish, revise, and tag university news bulletins and press releases</p>
    </div>
    <button type="button" class="btn btn-primary px-3 py-2 shadow-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#createNewsModal">
        <i class="bi bi-plus-circle me-1"></i> Create Article
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" placeholder="Search title or content..." />
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var c in categories)
                    {
                        <!option value="@c.CategoryID" @(currentCategory == c.CategoryID ? "selected" : "")>@c.CategoryName</!option>
                    }
                </select>
            </div>
            <div class="col-md-2 col-lg-2">
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <!option value="true" @(currentStatus == true ? "selected" : "")>Active</!option>
                    <!option value="false" @(currentStatus == false ? "selected" : "")>Inactive</!option>
                </select>
            </div>
            <div class="col-auto d-flex gap-2">
                <button type="submit" class="btn btn-dark px-3">Filter</button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentCategory.HasValue || currentStatus.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Articles Table Card -->
<div class="card border-0 shadow-sm overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">ID</th>
                    <th>Headline & Title</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Tags</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                            No articles match your query.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var art in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-secondary small">#@art.NewsArticleID</td>
                            <td style="max-width: 280px;">
                                <div class="fw-bold text-dark text-truncate">@art.Headline</div>
                                @if (!string.IsNullOrEmpty(art.NewsTitle) && art.NewsTitle != art.Headline)
                                {
                                    <div class="text-muted small text-truncate">@art.NewsTitle</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small">
                                    @(art.CategoryName ?? "General")
                                </span>
                            </td>
                            <td class="small text-muted">
                                <i class="bi bi-person me-1"></i>@(art.CreatedByName ?? "Staff")
                            </td>
                            <td class="small text-secondary">
                                @(art.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")
                            </td>
                            <td>
                                @if (art.NewsStatus == true)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                        <i class="bi bi-check-circle me-1"></i>Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-2 py-1 small">
                                        <i class="bi bi-x-circle me-1"></i>Inactive
                                    </span>
                                }
                            </td>
                            <td style="max-width: 180px;">
                                <div class="d-flex flex-wrap gap-1">
                                    @if (art.TagNames != null && art.TagNames.Any())
                                    {
                                        @foreach (var t in art.TagNames.Take(2))
                                        {
                                            <span class="badge bg-light text-secondary border small">#@t</span>
                                        }
                                        @if (art.TagNames.Count > 2)
                                        {
                                            <span class="badge bg-light text-secondary border small">+@(art.TagNames.Count - 2)</span>
                                        }
                                    }
                                </div>
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@art.NewsArticleID" target="_blank"
                                   class="btn btn-outline-secondary btn-sm rounded-pill px-2 me-1" title="Preview Public View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 me-1 btn-edit-news"
                                        data-bs-toggle="modal" data-bs-target="#editNewsModal"
                                        data-id="@art.NewsArticleID">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 btn-delete-news"
                                        data-bs-toggle="modal" data-bs-target="#deleteNewsModal"
                                        data-id="@art.NewsArticleID" data-headline="@art.Headline">
                                    <i class="bi bi-trash3 me-1"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ================= CREATE NEWS MODAL ================= -->
<div class="modal fade" id="createNewsModal" tabindex="-1" aria-labelledby="createNewsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="createNewsModalLabel">
                        <i class="bi bi-file-earmark-plus me-2"></i>Create News Article
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Article ID <span class="text-danger">*</span></label>
                            <input type="text" name="NewsArticleID" class="form-control" placeholder="e.g. NA01 or 123" required maxlength="20" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold text-secondary small">Headline <span class="text-danger">*</span></label>
                            <input type="text" name="Headline" class="form-control" placeholder="Catchy, informative headline..." required maxlength="150" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary small">News Title</label>
                            <input type="text" name="NewsTitle" class="form-control" placeholder="Full title of article..." maxlength="400" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Category <span class="text-danger">*</span></label>
                            <select name="CategoryID" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryID">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">News Source</label>
                            <input type="text" name="NewsSource" class="form-control" placeholder="e.g. University Press / Reuters" maxlength="400" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary small">Content <span class="text-danger">*</span></label>
                            <textarea name="NewsContent" class="form-control" rows="5" placeholder="Write full article content here..." maxlength="4000"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary small d-block">Tags</label>
                            <div class="d-flex flex-wrap gap-2 p-2 bg-light rounded-3 border">
                                @foreach (var tag in tags)
                                {
                                    <div class="form-check form-check-inline me-2">
                                        <input class="form-check-input" type="checkbox" name="TagIDs" value="@tag.TagID" id="createTag_@tag.TagID">
                                        <label class="form-check-label small" for="createTag_@tag.TagID">@tag.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="NewsStatus" value="true" id="createNewsStatus" checked>
                                <label class="form-check-label fw-semibold text-dark small" for="createNewsStatus">Active (Publish to Public News Portal)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Publish Article</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= EDIT NEWS MODAL ================= -->
<div class="modal fade" id="editNewsModal" tabindex="-1" aria-labelledby="editNewsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form method="post" id="editNewsForm" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="NewsArticleID" id="editNewsArticleId" />
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold" id="editNewsModalLabel">
                        <i class="bi bi-pencil-square me-2 text-warning"></i>Update News Article
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Article ID</label>
                            <input type="text" id="editNewsArticleIdDisplay" class="form-control bg-light" readonly />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold text-secondary small">Headline <span class="text-danger">*</span></label>
                            <input type="text" name="Headline" id="editHeadline" class="form-control" required maxlength="150" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary small">News Title</label>
                            <input type="text" name="NewsTitle" id="editNewsTitle" class="form-control" maxlength="400" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Category <span class="text-danger">*</span></label>
                            <select name="CategoryID" id="editCategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var c in categories)
                                {
                                    <option value="@c.CategoryID">@c.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">News Source</label>
                            <input type="text" name="NewsSource" id="editNewsSource" class="form-control" maxlength="400" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary small">Content <span class="text-danger">*</span></label>
                            <textarea name="NewsContent" id="editNewsContent" class="form-control" rows="5" maxlength="4000"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-secondary small d-block">Tags</label>
                            <div class="d-flex flex-wrap gap-2 p-2 bg-light rounded-3 border">
                                @foreach (var tag in tags)
                                {
                                    <div class="form-check form-check-inline me-2">
                                        <input class="form-check-input edit-tag-check" type="checkbox" name="TagIDs" value="@tag.TagID" id="editTag_@tag.TagID">
                                        <label class="form-check-label small" for="editTag_@tag.TagID">@tag.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="NewsStatus" value="true" id="editNewsStatus">
                                <label class="form-check-label fw-semibold text-dark small" for="editNewsStatus">Active (Publish to Public News Portal)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= DELETE CONFIRMATION MODAL ================= -->
<div class="modal fade" id="deleteNewsModal" tabindex="-1" aria-labelledby="deleteNewsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" id="deleteNewsForm" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteNewsId" />
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="deleteNewsModalLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Article Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="mb-0">
                        Are you sure you want to permanently delete news article: <br />
                        <strong id="deleteNewsHeadline" class="text-danger"></strong>?
                    </p>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash3 me-1"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Edit News Modal loader
            $(document).on('click', '.btn-edit-news', function () {
                var newsId = $(this).data('id');
                $('#editNewsArticleId').val(newsId);
                $('#editNewsArticleIdDisplay').val(newsId);
                $('#editNewsForm').attr('action', '/NewsArticles/Edit/' + encodeURIComponent(newsId));

                $.getJSON('/NewsArticles/GetNewsJson/' + encodeURIComponent(newsId), function (data) {
                    if (data) {
                        $('#editNewsArticleId').val(data.newsArticleID);
                        $('#editNewsArticleIdDisplay').val(data.newsArticleID);
                        $('#editHeadline').val(data.headline);
                        $('#editNewsTitle').val(data.newsTitle || '');
                        $('#editCategoryId').val(data.categoryID || '');
                        $('#editNewsSource').val(data.newsSource || '');
                        $('#editNewsContent').val(data.newsContent || '');
                        $('#editNewsStatus').prop('checked', data.newsStatus === true);

                        // Clear & check tags
                        $('.edit-tag-check').prop('checked', false);
                        if (data.tagIDs && data.tagIDs.length > 0) {
                            data.tagIDs.forEach(function (tid) {
                                $('#editTag_' + tid).prop('checked', true);
                            });
                        }
                    }
                });
            });

            // Delete News Modal loader
            $(document).on('click', '.btn-delete-news', function () {
                var newsId = $(this).data('id');
                var headline = $(this).data('headline');

                $('#deleteNewsId').val(newsId);
                $('#deleteNewsHeadline').text(headline + ' (ID: ' + newsId + ')');
                $('#deleteNewsForm').attr('action', '/NewsArticles/Delete/' + encodeURIComponent(newsId));
            });
        });
    </script>
}
